{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:theme && hexo clean && hexo generate && node bin/inline-home-css.js && node bin/normalize-generated-output.js",
    "build:theme": "cd themes/defaultone && BROWSERSLIST_IGNORE_OLD_DATA=1 ../../node_modules/.bin/tailwindcss -i source/css/tailwind.source.css -o source/css/build/tailwind.css --minify && node source/js/build.js",
    "build:all": "npm run build",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "./node_modules/.bin/hexo server",
    "admin:local": "HEXO_ADMIN=true ./node_modules/.bin/hexo server -i 127.0.0.1",
    "post:check": "node scripts/validate-posts.js",
    "publish": "node scripts/admin-publish.js",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "seo:check": "node bin/check-seo.js",
    "seo:submit": "node bin/submit-indexnow.js"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "dompurify": "3.4.15",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "morgan": "1.12.1",
    "ws": "8.21.3"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "cursor-effects": "^1.0.17",
    "form-data": "^4.0.6",
    "hexo": "^7.3.0",
    "hexo-cli": "^4.3.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.4.1",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-wordcount": "^6.0.1",
    "particles.js": "^2.0.0"
  },
  "devDependencies": {
    "admin-local": "npm:hexo-admin@^2.3.0",
    "glob-promise": "6.0.7",
    "postcss": "8.4.47",
    "tailwindcss": "^3.4.19",
    "terser": "5.36.0"
  }
}
