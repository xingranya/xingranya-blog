.nf-container
  display flex
  flex-direction column
  align-items center
  justify-content center
  min-height 55vh
  padding 36px 24px 64px
  text-align center

  .nf-code
    margin 0 0 20px
    color var(--primary-color)
    font-family 'Chillax-Variable', sans-serif
    font-size clamp(4.5rem, 12vw, 6rem)
    font-weight 600
    line-height 1
    letter-spacing -0.03em
    animation notfound-reveal 800ms cubic-bezier(0.16, 1, 0.3, 1) both

  h1
    margin 0 0 16px
    color var(--first-text-color)
    font-size clamp(1.75rem, 4vw, 2.5rem)
    font-weight 600
    line-height 1.3

  .nf-description
    max-width 32rem
    margin 0 0 28px
    color var(--second-text-color)
    font-size 1rem
    line-height 1.85
    text-wrap pretty

  .nf-actions
    display flex
    flex-wrap wrap
    align-items center
    justify-content center
    gap 12px

    a
      display inline-flex
      align-items center
      justify-content center
      gap 10px
      min-height 44px
      padding 8px 16px
      border-radius 9px
      color var(--first-text-color)
      background var(--third-background-color)
      font-size 0.92rem
      transition color 180ms, transform 240ms, background 180ms

      &:last-child
        background transparent

      &:hover
        color var(--primary-color)
        transform translateY(-2px)

      &:focus-visible
        outline 2px solid var(--primary-color)
        outline-offset 3px

@keyframes notfound-reveal
  from
    filter blur(6px)
    transform translateY(12px)
    clip-path inset(10% 0 0)
  to
    filter blur(0)
    transform none
    clip-path inset(0)

@media (prefers-reduced-motion: reduce)
  .nf-container .nf-code
    animation none

  .nf-container .nf-actions a
    transition none

    &:hover
      transform none
