$logo-title-font-size = 1.7rem
$desktop-search-icon-font-size = 1.5rem
$navbar-bar-line-height = 2.5px
$logo-image-box-width = 34px

@require '../../common/variables'

.navbar-container
  position relative
  font-family $default-font-family
  width 100%
  height 100%
  box-sizing border-box
  display flex
  align-items center
  justify-content center
  color var(--first-text-color)
  padding-top $scroll-progress-bar-height
  hover-style(
    false,
    0,
    0
  )

  // 玻璃单独绘制，避免导航自身成为子菜单的背景采样边界。
  &::before
    content ''
    position absolute
    inset 0
    pointer-events none
    background var(--background-color-transparent-40)
    -webkit-backdrop-filter blur(18px) saturate(1.12)
    backdrop-filter blur(18px) saturate(1.12)

  .navbar-content
    position relative
    height 100%
    width 100%
    max-width $navbar-width-pages
    display flex
    flex-direction row
    justify-content space-between
    align-items center
    z-index $z-index-5
    transition max-width 0.3s ease

    &.has-home-banner
      max-width $navbar-width-home

    .left
      display flex
      align-items center
      //transform-origin bottom
      //transition-t('transform', '0', '0.15', 'ease')
      //
      //.navbar-shrink &
      //  transform scale(0.9)
      //  transform-origin bottom

      if (hexo-config('defaults.logo') && hexo-config('defaults.logo') != '')
        //.logo-image
          //width $logo-image-box-width
          //height $logo-image-box-width
          //margin-right 12px
          //
          //+redefine-tablet()
          //  width: $logo-image-box-width * 0.9
          //  height: $logo-image-box-width * 0.9
          //
          //+redefine-mobile()
          //  width: $logo-image-box-width * 0.8
          //  height: $logo-image-box-width * 0.8
          //
          //img
          //  border-radius 6px
          //  width 100%

      .logo-title
        font-size $logo-title-font-size
        font-weight 600
        line-height 1.2
        color var(--first-text-color)
        transform translateY(1px)
        text-shadow 1px 1px 3px rgba(0, 0, 0, 0.3)
        letter-spacing 0.5px
        transition all 0.3s ease
        
        &:hover
          color var(--primary-color)
          transform translateY(1px) scale(1.03)
          text-shadow 2px 2px 4px rgba(0, 0, 0, 0.4)

        if hexo-config('global.fonts.title.enable') {
          font-family hexo-config('global.fonts.title.family')
        }

        h1
          margin 0
          font-size $logo-title-font-size
          font-weight 600
          line-height 1.2
          color var(--first-text-color)
          transform translateY(1px)
          text-shadow 1px 1px 3px rgba(0, 0, 0, 0.3)
          letter-spacing 0.5px

          +redefine-tablet()
            font-size: $logo-title-font-size * 0.9

          +redefine-mobile()
            font-size: $logo-title-font-size * 0.8

        +redefine-tablet()
          font-size: $logo-title-font-size * 0.9

        +redefine-mobile()
          font-size: $logo-title-font-size * 0.8

    .right
      .desktop
        .navbar-list
          display flex
          gap 16px
          align-items center

          +redefine-tablet()
            display none

          .navbar-item
            float left
            // padding 5px
            position relative
            font-size 0.9rem
            font-weight 500
            cursor pointer
            color var(--default-text-color)

            > .navbar-link
              display inline-flex
              min-height 44px
              align-items center
              padding 8px 10px
              color var(--first-text-color)
              font inherit
              background transparent
              border 0
              cursor pointer
              border-radius 8px
              transition color 160ms ease, background-color 160ms ease

            .navbar-action
              display flex
              min-width 44px
              min-height 44px
              align-items center
              justify-content center
              padding 8px
              color var(--first-text-color)
              font inherit

            > .navbar-link .fa-chevron-down
              transform rotate(0deg)
              transition transform 180ms ease

            &.dropdown-open > .navbar-link .fa-chevron-down
              transform rotate(180deg)

            > .navbar-link:hover,
            > .navbar-action:hover,
            > .navbar-link.active,
            &.dropdown-open > .navbar-link
              color var(--primary-color)
              background var(--background-color-transparent-40)

            &.search
              font-size $desktop-search-icon-font-size
              margin-left 26px

              i
                color var(--default-text-color)

            .sub-menu
              position absolute
              top 100%
              right auto
              left 50%
              -webkit-transform translate(-50%, 0)
              -o-transform translate(-50%, 0)
              transform translate(-50%, 0)
              margin 0
              width 176px
              min-width 176px
              max-width 176px
              box-sizing border-box
              text-align center
              list-style none
              padding 10px
              border-radius $redefine-border-radius-large
              border 1px solid var(--border-color)
              visibility hidden
              pointer-events none
              overflow hidden
              background var(--background-color-transparent-80)
              -webkit-backdrop-filter blur(24px) saturate(1.12)
              backdrop-filter blur(24px) saturate(1.12)
              box-shadow 0 12px 28px rgba(0, 0, 0, 0.12)

              li
                width 100%

              li a
                white-space nowrap
                color var(--default-text-color)
                font-size 1rem
                min-height 48px
                padding 0 14px
                display flex
                align-items center
                justify-content center
                text-align center
                border-radius 8px
                // 不动画化继承的 visibility，保证展开后立即可以聚焦。
                transition color 160ms ease, background-color 160ms ease

                &:hover
                  color var(--primary-color)
                  background-color var(--third-background-color)

        .navbar-list .navbar-item.dropdown-open > .sub-menu
          visibility visible
          pointer-events auto

      .mobile
        display flex
        justify-content space-between
        align-items center

        .icon-item
          display none
          position relative
          cursor pointer
          font-size 18px
          margin-left 8px
          min-width 44px
          min-height 44px
          width 44px
          height 44px
          color var(--first-text-color)
          background transparent

          i
            color var(--default-text-color)

          &:first-child
            margin-left 0

          +redefine-tablet()
            display flex
            justify-content center
            align-items center

        .navbar-bar
          .navbar-bar-middle
            width 18px
            height $navbar-bar-line-height
            position relative
            background var(--default-text-color)

            .navbar-drawer-show &
              background transparent

            &::before, &::after
              content ''
              position absolute
              left 0
              width 100%
              height $navbar-bar-line-height
              background var(--default-text-color)
              transition-t('transform', '0', '0.38', 'ease')

            &::before
              top -6px

              .navbar-drawer-show &
                transform translateY(6px) rotate(45deg)

            &::after
              bottom -6px

              .navbar-drawer-show &
                transform translateY(-6px) rotate(-45deg)

  .navbar-drawer
    padding $navbar-height 0 20px 0
    transform translateX(100%)
    transform-origin top
    z-index $z-index-2
    height 100vh
    overflow-y auto
    transition-t('transform', '0', '0.38', 'ease')

    .navbar-drawer-show &
      transform translateX(0)

  .window-mask
    position absolute
    top 0
    width 100%
    height 100vh
    background rgba(0, 0, 0, 0.4)
    z-index $z-index-1
    visibility hidden
    opacity 0
    transition-t('transform, opacity', '0, 0', '0.38, 0.38', 'ease, ease')

    .navbar-drawer-show &
      visibility visible
      opacity 1

.navbar-drawer-show
  overflow hidden

[data-target] {
  display: block; /* or flex, depending on your layout */
  overflow: hidden;
}

[data-target] .submenu-item {
  opacity: 0;
}

.icon-rotated {
  transform: rotate(90deg);
}

.transition-navbar
  transition max-width 0.3s ease-out

html.is-animating
  .transition-navbar
    max-width $navbar-width-pages !important
    transition max-width 0.2s ease-out

body.navbar-shrink .navbar-container::before
  background var(--background-color-transparent-80)
