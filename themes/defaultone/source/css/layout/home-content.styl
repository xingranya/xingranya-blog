@require '../common/variables'
@require '../common/redefine-theme'

.home-content-container
  width 100%
  min-width 0

  .seo-reader-text
    border 0
    clip rect(1px, 1px, 1px, 1px)
    -webkit-clip-path inset(50%)
    clip-path inset(50%)
    height 1px
    margin -1px
    overflow hidden
    padding 0
    position absolute !important
    width 1px
    word-wrap normal !important
    word-break normal

  .home-latest-heading
    margin 0 0 14px
    padding 0 2px
    color var(--first-text-color)
    font-size 1.3rem
    font-weight 600
    line-height 1.5

  .home-article-list
    .home-article-item
      position relative
      redefine-container(
        false,
        1,
        1,
        0px,
        18px
      )
      overflow hidden
      border 1px solid var(--border-color)
      box-shadow var(--redefine-box-shadow-flat)
      transition transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease

      &.has-thumbnail
        display grid
        grid-template-columns minmax(210px, 30%) minmax(0, 1fr)

      &:hover
        transform translateY(-2px)
        box-shadow var(--redefine-box-shadow)
        border-color rgba(255, 192, 203, 0.35)

      @media (prefers-reduced-motion: reduce)
        transition none

        &:hover
          transform none

      +redefine-tablet()
        &.has-thumbnail
          grid-template-columns minmax(180px, 32%) minmax(0, 1fr)

      +redefine-mobile()
        &.has-thumbnail
          display block
      
      .home-article-thumbnail
        position relative
        width 100%
        height 100%
        min-height 190px
        max-height 230px
        border-radius $redefine-border-radius-large 0 0 $redefine-border-radius-large
        background linear-gradient(135deg, rgba(255, 192, 203, 0.16), rgba(54, 125, 247, 0.12)), var(--third-background-color)
        
        +redefine-tablet()
          min-height 175px
          max-height 215px
          
        +redefine-mobile()
          width 100%
          height 158px
          min-height 158px
          max-height 158px
          border-radius $redefine-border-radius-large-top
        
        &::after
          content ""
          position absolute
          inset 0
          background linear-gradient(90deg, transparent 68%, var(--background-color-transparent-40) 100%)
          pointer-events none
          z-index 1

          +redefine-mobile()
            background linear-gradient(to bottom, transparent 72%, var(--background-color-transparent-40) 100%)

      .home-article-thumbnail img
          width 100%
          height 100%
          object-fit cover
          position absolute
          top 0
          left 0
          transition transform 0.35s ease

      &:hover .home-article-thumbnail img
        transform scale(1.025)

      .home-article-body
        min-width 0
        display flex
        flex-direction column
        justify-content center
        gap 12px
        padding 20px 22px

        +redefine-tablet()
          padding 18px

        +redefine-mobile()
          gap 10px
          padding 16px

      .home-article-title
        position relative
        font-weight 600
        font-size 1.28rem
        z-index 2
        line-height 1.42
        color var(--second-text-color)
        font-family $english-font-family, $chinese-font-family, 'Noto Sans SC', sans-serif
        display -webkit-box
        -webkit-box-orient vertical
        -webkit-line-clamp 2
        overflow hidden

        +redefine-tablet()
          font-size 1.2rem

        +redefine-mobile()
          font-size 1.12rem

        margin 0

      .home-article-content
        max-width 70ch
        word-wrap break-word
        text-align start
        color var(--default-text-color)
        font-size 0.95rem
        line-height 1.55

        p
          margin 0
          display -webkit-box
          -webkit-box-orient vertical
          -webkit-line-clamp 2
          overflow hidden

      .home-article-meta-info-container
        display flex
        justify-content space-between
        align-items center
        font-size 0.92rem
        color var(--third-text-color)

        .home-article-meta-info
          letter-spacing 0.5px
          min-width 0
          display flex
          flex-wrap wrap
          row-gap 5px

          span
            margin-right 10px

            &:last-child
              margin-right 0

            ul, li
              display inline

          .home-article-tag
            +redefine-mobile()
              display none

        hr
          border none
          flex 1
          height 1px
          background var(--border-color)
          margin 0 10px

        a
          color var(--third-text-color)

          &:hover
            color var(--primary-color)

        .home-article-read-more
          display inline-flex
          min-height 38px
          align-items center
          flex-shrink 0
          color var(--first-text-color)
          font-weight 600
          white-space nowrap

          &:hover
            color var(--primary-color)
