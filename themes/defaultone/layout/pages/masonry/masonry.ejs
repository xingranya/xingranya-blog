<%
// Define an array of images to display in the masonry layout
const images = theme.masonry;
%>

<h1 class="page-title-header">
	<%- getPageTitle(page) %>
</h1>

<div class="loading-placeholder">
	<div class="flex-grid generic-card">
		<div class="card loading"></div>
		<div class="card loading"></div>
		<div class="card loading"></div>
	</div>
</div>

<div id="masonry-container">
	<% images.forEach(function(image, index) { %>
	<div class="masonry-item">
		<div class="image-container">
			<div class="gallery-image-loader" aria-hidden="true"><i class="fa-regular fa-image"></i></div>
			<img src="<%= image.image %>" alt="相册图片 <%= index + 1 %>" loading="lazy" decoding="async" tabindex="0" role="button" aria-label="预览第 <%= index + 1 %> 张图片">
		</div>
	</div>
	<% }); %>
</div>
