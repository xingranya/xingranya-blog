<script>
  (function () {
    if (window.__redefineCoreLoaderBound) return;
    window.__redefineCoreLoaderBound = true;

    var scriptPromises = new Map();
    var swupSources = <%- JSON.stringify([
      'libs/Swup.min.js',
      'libs/SwupSlideTheme.min.js',
      'libs/SwupScriptsPlugin.min.js',
      'libs/SwupProgressPlugin.min.js',
      'libs/SwupScrollPlugin.min.js',
      'libs/SwupPreloadPlugin.min.js'
    ].map(function (path) { return url_for('/js/build/' + path); })) %>;

    function loadScript(src, id, module) {
      if (scriptPromises.has(src)) return scriptPromises.get(src);
      var promise = new Promise(function (resolve, reject) {
        var existing = id && document.getElementById(id);
        if (existing) {
          if (existing.dataset.loaded === 'true') resolve();
          else existing.addEventListener('load', resolve, { once: true });
          return;
        }
        var script = document.createElement('script');
        script.src = src;
        if (id) script.id = id;
        if (module) script.type = 'module';
        script.addEventListener('load', function () {
          script.dataset.loaded = 'true';
          resolve();
        }, { once: true });
        script.addEventListener('error', reject, { once: true });
        document.head.appendChild(script);
      });
      scriptPromises.set(src, promise);
      return promise;
    }

    function loadStylesheet(href, id) {
      if (id && document.getElementById(id)) return;
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      if (id) link.id = id;
      document.head.appendChild(link);
    }

    window.__redefineLoadScript = loadScript;

    window.__redefineLoadCore = function () {
      if (window.__redefineCorePromise) return window.__redefineCorePromise;

      window.__redefineCorePromise = (async function () {
        if (window.__redefineSinglePageEnabled) {
          for (var source of swupSources) await loadScript(source);
          window.swup = new window.Swup({
            plugins: [
              new window.SwupScriptsPlugin({ optin: true }),
              new window.SwupProgressPlugin(),
              new window.SwupScrollPlugin({ offset: 80 }),
              new window.SwupSlideTheme({ mainElement: '.main-content-body' }),
              new window.SwupPreloadPlugin(),
            ],
            containers: ['#swup'],
          });
        }

        await loadScript(<%- JSON.stringify(url_for('/js/build/libs/anime.min.js')) %>);
        await loadScript(<%- JSON.stringify(url_for('/js/build/main.js')) %>, 'redefine-main', true);

        <% if (theme.footer.runtime) { %>
        loadStylesheet(<%- JSON.stringify(url_for('/assets/odometer-theme-minimal.css')) %>, 'redefine-odometer-style');
        await loadScript(<%- JSON.stringify(url_for('/js/build/libs/odometer.min.js')) %>);
        await loadScript(<%- JSON.stringify(url_for('/js/build/tools/runtime.js')) %>);
        <% } %>

        <% if (theme.plugins.mermaid.enable) { %>
        await loadScript(<%- JSON.stringify(theme.plugins.mermaid.version === '11.4.1'
          ? url_for('/js/build/libs/mermaid.min.js')
          : 'https://cdn.jsdelivr.net/npm/mermaid@' + theme.plugins.mermaid.version + '/dist/mermaid.min.js') %>);
        await loadScript(<%- JSON.stringify(url_for('/js/build/plugins/mermaid.js')) %>);
        <% } %>

        <% if (theme.articles.pangu_js) { %>
        await loadScript(<%- JSON.stringify(url_for('/js/build/libs/pangu.min.js')) %>);
        await loadScript(<%- JSON.stringify(url_for('/js/build/plugins/pangu.js')) %>);
        <% } %>

        window.__redefineCoreReady = true;
        document.dispatchEvent(new CustomEvent('redefine:core-ready'));
      })().catch(function (error) {
        window.__redefineCorePromise = null;
        console.error(error);
        throw error;
      });

      return window.__redefineCorePromise;
    };

    function recordIntent() {
      window.__redefineUserInteracted = true;
      window.__redefineLoadCore().catch(function () {});
    }

    window.addEventListener('pointerdown', recordIntent, { once: true, passive: true });
    window.addEventListener('touchstart', recordIntent, { once: true, passive: true });
    window.addEventListener('keydown', recordIntent, { once: true });
    window.addEventListener('scroll', recordIntent, { once: true, passive: true });
    if (!matchMedia('(pointer: coarse)').matches) {
      window.addEventListener('pointermove', recordIntent, { once: true, passive: true });
    }

    document.addEventListener('click', function (event) {
      if (window.__redefineCoreReady) return;
      var control = event.target.closest(
        '.search-popup-trigger, .navbar-bar, [navbar-data-toggle], .right-side-tools-container button, .markdown-body img'
      );
      if (!control) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      window.__redefineUserInteracted = true;
      window.__redefineLoadCore().then(function () { control.click(); }).catch(function () {});
    }, true);

    function scheduleAfterLoad() {
      window.setTimeout(function () {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(function () { window.__redefineLoadCore().catch(function () {}); }, { timeout: 2000 });
        } else {
          window.__redefineLoadCore().catch(function () {});
        }
      }, 1000);
    }

    if (document.readyState === 'complete') scheduleAfterLoad();
    else window.addEventListener('load', scheduleAfterLoad, { once: true });
  })();
</script>

<script>
  (function () {
    if (window.__redefineEnhancementsBound) return;
    window.__redefineEnhancementsBound = true;

    var root = <%- JSON.stringify(config.root) %>;
    var reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    var loadedScripts = new Map();

    function loadScript(src, id) {
      if (loadedScripts.has(src)) return loadedScripts.get(src);
      var promise = new Promise(function (resolve, reject) {
        var existing = id && document.getElementById(id);
        if (existing) {
          if (existing.dataset.loaded === 'true') resolve();
          else existing.addEventListener('load', resolve, { once: true });
          return;
        }
        var script = document.createElement('script');
        script.src = src;
        if (id) script.id = id;
        script.addEventListener('load', function () {
          script.dataset.loaded = 'true';
          resolve();
        }, { once: true });
        script.addEventListener('error', reject, { once: true });
        document.head.appendChild(script);
      });
      loadedScripts.set(src, promise);
      return promise;
    }

    async function enhanceCurrentPage() {
      if (document.getElementById('masonry-container')) {
        await loadScript(root + 'js/build/libs/minimasonry.min.js', 'redefine-minimasonry');
        var masonry = await import(root + 'js/build/plugins/masonry.js');
        masonry.initMasonry();
      }
      if (document.querySelector('.essay-date')) {
        await loadScript(root + 'js/build/libs/moment-with-locales.min.js', 'redefine-moment');
        var essays = await import(root + 'js/build/layouts/essays.js');
        essays.formatEssayDates();
      }
    }

    function startOptionalEffects() {
      if (reducedMotion.matches || document.visibilityState !== 'visible') return;

      <% if (theme.effects.particles) { %>
      loadScript(root + 'js/build/libs/particles.min.js', 'redefine-particles').then(function () {
        return import(root + 'js/build/layouts/setup-particles.js');
      }).then(function (particles) { particles.default(); }).catch(console.error);
      <% } %>

      <% if (theme.effects.cursoreffects) { %>
      if (!matchMedia('(pointer: coarse)').matches) {
        loadScript(root + 'js/build/libs/cursor-effects.js', 'redefine-cursor-effects').then(function () {
          return import(root + 'js/build/layouts/setup-cursor.js');
        }).then(function (cursor) { cursor.default(); }).catch(console.error);
      }
      <% } %>

      <% const live2dConfig = config.live2d || {}; if (live2dConfig.enable) {
        const live2dScriptSrc = live2dConfig.script && live2dConfig.script.src ? live2dConfig.script.src : '/live2dw/lib/L2Dwidget.min.js';
        const live2dWidgetConfig = {
          log: Boolean(live2dConfig.log),
          model: { jsonPath: url_for(live2dConfig.model && live2dConfig.model.jsonPath ? live2dConfig.model.jsonPath : '/live2dw/assets/wanko.model.json') },
          display: live2dConfig.display || { position: 'right', width: 150, height: 300 },
          mobile: live2dConfig.mobile || { show: false },
          react: live2dConfig.react || { opacity: 0.7 }
        };
      %>
      var live2dConfig = <%- JSON.stringify(live2dWidgetConfig) %>;
      if (live2dConfig.mobile.show || !matchMedia('(max-width: 768px)').matches) {
        loadScript(<%- JSON.stringify(url_for(live2dScriptSrc)) %>, 'redefine-live2d').then(function () {
          if (window.L2Dwidget && !window.__redefineLive2dStarted) {
            window.__redefineLive2dStarted = true;
            window.L2Dwidget.init(live2dConfig);
          }
        }).catch(console.error);
      }
      <% } %>
    }

    function scheduleOptionalEffects() {
      var started = false;
      function start() {
        if (started) return;
        started = true;
        if (window.__redefineCoreReady) startOptionalEffects();
        else document.addEventListener('redefine:core-ready', startOptionalEffects, { once: true });
      }
      window.addEventListener('pointerdown', start, { once: true, passive: true });
      window.addEventListener('touchstart', start, { once: true, passive: true });
      window.addEventListener('keydown', start, { once: true });
      window.addEventListener('scroll', start, { once: true, passive: true });
      if (!matchMedia('(pointer: coarse)').matches) {
        window.addEventListener('pointermove', start, { once: true, passive: true });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        enhanceCurrentPage().catch(console.error);
        scheduleOptionalEffects();
      }, { once: true });
    } else {
      enhanceCurrentPage().catch(console.error);
      scheduleOptionalEffects();
    }

    function bindPageView() {
      if (!window.swup || !window.swup.hooks || window.__redefineEnhancementsSwupBound) return;
      window.__redefineEnhancementsSwupBound = true;
      window.swup.hooks.on('page:view', function () {
        enhanceCurrentPage().catch(console.error);
      });
    }

    bindPageView();
    document.addEventListener('redefine:core-ready', bindPageView, { once: true });
  })();
</script>
