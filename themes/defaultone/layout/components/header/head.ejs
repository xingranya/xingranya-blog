<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <script>
    (function () {
      var dark = matchMedia('(prefers-color-scheme: dark)').matches;
      try {
        var saved = JSON.parse(localStorage.getItem('REDEFINE-THEME-STATUS') || '{}');
        if (typeof saved.isDark === 'boolean') dark = saved.isDark;
      } catch (error) {}
      document.documentElement.classList.add(dark ? 'dark' : 'light');
      window.__redefineIsDark = dark;
      <% if (theme.home_banner.enable && is_home()) { %>
      var image = dark ? <%- JSON.stringify(url_for(theme.home_banner.image.dark)) %> : <%- JSON.stringify(url_for(theme.home_banner.image.light)) %>;
      if (matchMedia('(max-width: 768px)').matches) image = image.replace(/\.webp$/, '-mobile.webp');
      var preload = document.createElement('link');
      preload.rel = 'preload';
      preload.as = 'image';
      preload.href = image;
      preload.fetchPriority = 'high';
      document.head.appendChild(preload);
      <% } %>
    })();
  </script>
  <%- css('css/style') %>
  <% if (theme.developer && theme.developer.enable) { %>
  <%- css('css/build/tailwind.css') %>
  <% } else { %>
  <%- renderCSS('css/build/tailwind.css') %>
  <% } %>
  <% const seoPage = seoPageData(config, theme, page); const pageDescription = seoPage.description; %>
  <meta name="keywords" content="<%= seoKeywords(config, page) %>">
  <meta name="description" content="<%= pageDescription %>">
  <meta name="author" content="<%= theme.info.author || config.author %>">
  <%- generateMeta(theme, page) %>
  <%- autoCanonical(config, page) %>
  <%- seoJsonLd(config, theme, page) %>
  <link rel="alternate" type="application/atom+xml" title="<%= theme.info.title || config.title %>" href="<%= url_for('/atom.xml') %>">
  <link rel="alternate" type="text/plain" title="站点内容索引" href="<%= url_for('/llms.txt') %>">
  <% if (isPublicArticle(page)) { %>
  <link rel="alternate" type="text/markdown" title="Markdown 原文" href="<%= url_for(markdownPath(page)) %>">
  <% } %>
  <% if (theme.global.open_graph?.enable || theme.global.open_graph === true) { %>
    <%- stableOpenGraph(open_graph({ image: seoImage(config, theme, page), author: page.author || config.author, description: pageDescription, twitter_card: 'summary_large_image', twitter_image: seoImage(config, theme, page) })) %>
  <% } %>
  <% const faviconType = String(theme.defaults.favicon).replace(/\?.*$/, '').endsWith('.webp') ? 'image/webp' : 'image/png'; %>
  <link rel="icon" type="<%= faviconType %>" href="<%= url_for(theme.defaults.favicon) %>" sizes="any">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= url_for(theme.defaults.favicon_png || theme.defaults.favicon) %>">
  <meta name="theme-color" content="<%= theme.colors.primary %>">
  <title><%= seoPage.title %></title>
  <style>
    @font-face { font-family: 'Geist Variable'; src: url('/fonts/Geist/GeistVF.woff2') format('woff2'); font-weight: 200 700; font-style: normal; font-display: optional; }
    @font-face { font-family: 'Chillax-Variable'; src: url('/fonts/Chillax/Chillax-Variable.woff2') format('woff2'); font-weight: 200 700; font-style: normal; font-display: optional; }
    @font-face { font-family: 'Geist Mono'; src: url('/fonts/GeistMono/GeistMonoVF.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: optional; }
    .home-banner-subtitle { display: flex; min-height: 3.25rem; max-width: min(90vw, 48rem); align-items: center; justify-content: center; }
    .fa, .fa-brands, .fa-regular, .fa-solid, .fab, .far, .fas { display: inline-block; min-width: 1em; font-style: normal; font-variant: normal; line-height: 1; text-align: center; }
    .fa-fw { width: 1.25em; }
    .home-banner-background { background-image: url('<%= url_for(theme.home_banner.image.dark) %>'); background-position: center; background-size: cover; }
    html.light .home-banner-background { background-image: url('<%= url_for(theme.home_banner.image.light) %>'); }
    @media (max-width: 768px) {
      .home-banner-background { background-image: url('<%= url_for(theme.home_banner.image.dark.replace(/\.webp$/, '-mobile.webp')) %>'); }
      html.light .home-banner-background { background-image: url('<%= url_for(theme.home_banner.image.light.replace(/\.webp$/, '-mobile.webp')) %>'); }
    }
    @media (min-width: 640px) { .home-banner-subtitle { min-height: 1.75rem; } }
  </style>
  <% const fontUrls = [theme.home_banner.custom_font, theme.articles.code_block.font, ...Object.values(theme.global.fonts)].filter(font => font && font.enable && font.url); %>
  <% for (const font of fontUrls) { %>
  <link href="<%= font.url %>" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link href="<%= font.url %>" rel="stylesheet"></noscript>
  <% } %>
  <% for (const fontAwesomeStyle of ['fontawesome/fontawesome.min.css', 'fontawesome/brands.min.css', 'fontawesome/solid.min.css', 'fontawesome/regular.min.css']) { %>
    <link rel="stylesheet" href="<%= url_for('/' + fontAwesomeStyle) %>" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="<%= url_for('/' + fontAwesomeStyle) %>"></noscript>
  <% } %>
  <style>
    @font-face { font-family: 'Font Awesome 6 Pro'; font-style: normal; font-weight: 900; font-display: swap; src: url('/webfonts/fa-solid-900-subset.woff2') format('woff2'); }
    @font-face { font-family: 'Font Awesome 6 Pro'; font-style: normal; font-weight: 400; font-display: swap; src: url('/webfonts/fa-regular-400-subset.woff2') format('woff2'); }
    @font-face { font-family: 'Font Awesome 6 Brands'; font-style: normal; font-weight: 400; font-display: swap; src: url('/webfonts/fa-brands-400-subset.woff2') format('woff2'); }
  </style>
  <% for (const [option, name] of [['thin', 'thin'], ['light', 'light'], ['duotone', 'duotone'], ['sharp_solid', 'sharp-solid']]) { %>
    <% if (theme.fontawesome[option]) { %><%- renderCSS('fontawesome/' + name + '.min.css') %><% } %>
  <% } %>
  <%- export_config() %>
  <% if (theme.global.google_analytics.enable) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= theme.global.google_analytics.id %>"></script>
    <script>window.dataLayer = window.dataLayer || []; function gtag() { dataLayer.push(arguments); } gtag('js', new Date()); gtag('config', '<%= theme.global.google_analytics.id %>');</script>
  <% } %>
  <% if (theme.inject.enable) { for (const item of theme.inject.head || []) { if (item) { %>
    <%- theme.global.single_page ? item.replace('<script', '<script data-swup-reload-script') : item %>
  <% } } } %>
</head>
