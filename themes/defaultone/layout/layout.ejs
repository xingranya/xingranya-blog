<!DOCTYPE html>
<html lang="<%= config.language %>" class="<%= theme.colors.default_mode === 'dark' ? 'dark' : 'light' %>">
<%- partial('components/header/head') %>
<body class="<%= theme.colors.default_mode === 'dark' ? 'dark-mode' : 'light-mode' %>">
  <script>
    document.body.classList.toggle('dark-mode', window.__redefineIsDark);
    document.body.classList.toggle('light-mode', !window.__redefineIsDark);
  </script>
  <%- body %>
  <%- partial('components/scripts') %>
  <% if (theme.plugins.aplayer.enable) { %><%- partial('components/plugins/aplayer') %><% } %>
  <% if (theme.effects.particles) { %>
  <div id="particles-js" aria-hidden="true" style="position:fixed;inset:0;z-index:1;pointer-events:none"></div>
  <% } %>
</body>
</html>
