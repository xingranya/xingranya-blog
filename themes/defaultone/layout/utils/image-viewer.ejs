<div class="image-viewer-container" role="dialog" aria-modal="true" aria-label="图片预览" aria-hidden="true" inert>
  <div class="image-viewer-toolbar">
    <span class="image-viewer-counter"></span>
    <div class="image-viewer-actions">
      <button type="button" data-viewer-action="previous" aria-label="上一张图片" title="上一张（←）"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
      <button type="button" data-viewer-action="next" aria-label="下一张图片" title="下一张（→）"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
      <button type="button" data-viewer-action="zoom-out" aria-label="缩小图片"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
      <button type="button" data-viewer-action="reset" aria-label="还原图片大小" title="还原大小">100%</button>
      <button type="button" data-viewer-action="zoom-in" aria-label="放大图片"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
      <button type="button" data-viewer-action="close" aria-label="关闭图片预览" title="关闭（Esc）"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
  </div>
  <div class="image-viewer-stage">
    <img alt="图片预览" draggable="false">
    <p class="image-viewer-status" role="status"></p>
  </div>
  <div class="image-viewer-footer">
    <span class="image-viewer-desktop-help">方向键切换 · 滚轮缩放 · Esc 关闭</span>
    <span class="image-viewer-mobile-help">左右滑动切换图片</span>
    <a class="image-viewer-original" target="_blank" rel="noopener">打开原图 <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
  </div>
</div>
